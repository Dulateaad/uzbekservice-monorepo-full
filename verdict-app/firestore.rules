rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /verdict_cards/{cardId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
    match /verdict_objects/{objectId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /verdict_votes/{voteId} {
      allow read: if true;
      allow create: if true;
      /* Переголосование: один документ на user+card (детерминированный id), merge update */
      allow update: if true;
      allow delete: if true;
    }
    match /geo_content_cache/{cacheId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /geo_generation_queue/{queueId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
