# Verdict — отдельный Firebase проект
# Создайте проект: https://console.firebase.google.com
# Скопируйте в .env и заполните

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=verdict-c5e0d
VITE_FIREBASE_AUTH_DOMAIN=verdict-c5e0d.firebaseapp.com
# appspot.com — старые проекты; firebasestorage.app — новые (Oct 2024+)
VITE_FIREBASE_STORAGE_BUCKET=verdict-c5e0d.firebasestorage.app

# Для генерации карточек через Gemini (npm run generate:cards, generate:city):
GEMINI_API_KEY=

# Для скрипта генерации картинок (npm run generate:images):
# 1. Включите Vertex AI API в GCP и настройте биллинг
# 2. gcloud auth application-default login
#    или GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# 3. Опционально: GOOGLE_CLOUD_LOCATION=us-central1
