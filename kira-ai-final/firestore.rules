rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a robust User-Ownership and Role-Based Access Control (RBAC) model. 
     * Security is enforced through structural segregation and strategic denormalization.
     * 
     * DATA STRUCTURE
     * 1. Private User Data: Nested under /userProfiles/{userId}/ to enforce path-based security.
     * 2. Public Catalog Data: Top-level collections (/products, /product_images) for global readability.
     * 3. Administrative Roles: Managed via the /roles_admin/ collection where document existence signifies admin status.
     * 
     * KEY SECURITY DECISIONS
     * - Authorization Independence: Critical fields (userId, associatedUserId) are denormalized 
     *   directly onto documents to avoid costly get() calls during security evaluation.
     * - Prototyping Mode: Rules enforce "Who" can access data and "Relational Integrity" (ensuring 
     *   data belongs to the path it resides in), but do not enforce strict schema types or optional fields.
     * - Strict Writes: No "allow write: if true" is permitted. All writes require authenticated authorization.
     */

    // --- Global Helper Functions ---

    /** Checks if the requester is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the requester's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the requester is an administrator based on the existence of an admin role document. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** Combines ownership check with document existence for destructive operations. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the UserProfile entity. Users can only manage their own profile.
     * @path /userProfiles/{userId}
     * @allow (get, list, create, update) if userId matches request.auth.uid.
     * @deny (create) if the internal 'id' field does not match the path userId.
     * @principle Path-based ownership and internal field consistency.
     */
    match /userProfiles/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Metadata for images uploaded by the user (profile pics, try-on inputs).
       * @path /userProfiles/{userId}/images/{imageId}
       * @allow (all) if the authenticated user owns the parent userProfile.
       * @deny (create) if 'associatedUserId' does not match the path parameter.
       * @principle Enforces private subcollection ownership via denormalized link.
       */
      match /images/{imageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.associatedUserId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.associatedUserId == resource.data.associatedUserId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Tracking AI processing requests for virtual try-on.
       * @path /userProfiles/{userId}/virtual_try_on_requests/{requestId}
       * @allow (all) if the authenticated user owns the parent userProfile.
       * @deny (update) if the 'userId' field is modified.
       * @principle Authorization Independence via immutable ownership fields.
       */
      match /virtual_try_on_requests/{requestId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Metadata for images generated by the AI stylist.
       * @path /userProfiles/{userId}/generated_outfits/{imageId}
       * @allow (all) if the authenticated user owns the parent userProfile.
       * @deny (list) if the requester is not the userId in the path.
       * @principle Structural segregation of generated content from user uploads.
       */
      match /generated_outfits/{imageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.associatedUserId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.associatedUserId == resource.data.associatedUserId;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Product catalog accessible to everyone for viewing.
     * @path /products/{productId}
     * @allow (get, list) for any visitor.
     * @allow (create, update, delete) only for users with the admin role.
     * @deny (write) if the user is not an admin.
     * @principle Public read with restricted administrative write access.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == productId;
      allow update: if isAdmin() && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Publicly readable images linked to products in the catalog.
     * @path /product_images/{imageId}
     * @allow (get, list) for any visitor.
     * @allow (create, update, delete) only for administrators.
     * @principle Global catalog images with administrative management.
     */
    match /product_images/{imageId} {
      allow get, list: if true;
      allow create: if isAdmin() && request.resource.data.id == imageId;
      allow update: if isAdmin() && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Role mapping for administrative privileges.
     * @path /roles_admin/{userId}
     * @allow (read) for administrators only (to prevent user enumeration).
     * @deny (write) if attempted from the client. Roles should be managed via server-side logic.
     * @principle Database Access Control (DBAC) via existence checks.
     */
    match /roles_admin/{userId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false; 
    }
  }
}