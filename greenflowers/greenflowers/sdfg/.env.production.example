# Прод-сборка: NEXT_PUBLIC_* встраиваются в клиент при next build.
# HTTP API (sprayApi) не используем — только Firebase.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=greenflowers-15776.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=greenflowers-15776
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=greenflowers-15776.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Опционально: отдельный REST-сервер (транспорт, админ-статы и т.д.)
# NEXT_PUBLIC_API_URL=https://example.com/api
