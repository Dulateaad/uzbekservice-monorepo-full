# Локально: .env.development. Прод: .env.production.
# Опционально: свой REST-бэкенд (по умолчанию не нужен — данные в Firestore).
# NEXT_PUBLIC_API_URL=https://example.com/api

# Firebase Web App (Project settings → Your apps)
# Скопируй из Firebase Console → Project settings → Your apps → SDK setup (npm)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=greenflowers-15776.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=greenflowers-15776
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=greenflowers-15776.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
