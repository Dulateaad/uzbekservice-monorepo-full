# Self-hosted map services (docker-compose)
VITE_TILE_SERVER_URL=http://localhost:8080
VITE_NOMINATIM_URL=http://localhost:8088
VITE_OSRM_URL=http://localhost:5000

# Firebase (for Firestore real-time — legacy, migrating to server API)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Google Cloud API key (for Vision API fallback + Document AI)
VITE_GOOGLE_API_KEY=

# Google Document AI + Vision (обязательно Project ID, например taxi-eb8b7, НЕ номер проекта)
# Enable: Document AI API + Cloud Vision API. Key restrictions: add your hosting domain or leave unrestricted.
VITE_GCP_PROJECT_ID=
VITE_DOCAI_LOCATION=us
VITE_DOCAI_DOC_PROCESSOR_ID=
VITE_DOCAI_OCR_PROCESSOR_ID=
