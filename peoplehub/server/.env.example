# Database
DATABASE_URL="postgresql://peoplehub:peoplehub@localhost:5432/peoplehub?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="PeopleHubBot"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Self-hosted Maps (no paid APIs)
OSRM_URL="http://localhost:5000"
NOMINATIM_URL="http://localhost:8088"

# Pricing
BASE_FARE_KZT=500
PER_KM_FARE_KZT=120
PER_MIN_FARE_KZT=40
MIN_FARE_KZT=800
WAIT_PER_MIN_KZT=100

# Driver subscription
DRIVER_DAILY_FEE_KZT=200

# GPS Anti-fraud
GPS_ACCURACY_THRESHOLD=30
ARRIVAL_RADIUS_METERS=120
START_RADIUS_METERS=200
ARRIVAL_HOLD_SECONDS=20
MAX_ARRIVAL_SPEED_KMH=8
NO_SHOW_WAIT_MINUTES=10
MAX_TIME_AFTER_PAYMENT_MINUTES=15
