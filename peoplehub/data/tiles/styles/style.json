{
  "version": 8,
  "name": "PeopleHub Map",
  "metadata": {
    "description": "Self-hosted map style for PeopleHub. OpenMapTiles schema, Russian labels."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{kazakhstan}"
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "sprite": "",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f0f0f0"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0cfdf",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a0cfdf",
        "line-width": 1.5
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#d4e7c5",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#b8d9a0",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {
        "fill-color": "#e8e0d8",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "commercial", "retail"],
      "paint": {
        "fill-color": "#f2e6d9",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c8e6b0",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d6d1c9",
        "fill-opacity": {
          "stops": [[13, 0.3], [16, 0.6]]
        }
      }
    },
    {
      "id": "building-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "line-color": "#c0b8ae",
        "line-width": 0.5,
        "line-opacity": 0.5
      }
    },
    {
      "id": "tunnel",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "brunnel", "tunnel"]],
      "paint": {
        "line-color": "#d8d8d8",
        "line-width": {
          "stops": [[10, 1], [14, 4], [18, 12]]
        },
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "road-service",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "service"], ["!=", "brunnel", "tunnel"]],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [[13, 0.5], [16, 3], [18, 6]]
        }
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "minor", "track"], ["!=", "brunnel", "tunnel"]],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [[12, 0.5], [14, 2], [18, 8]]
        }
      }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "tertiary"], ["!=", "brunnel", "tunnel"]],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [[10, 0.5], [13, 2], [16, 6], [18, 12]]
        }
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "secondary"], ["!=", "brunnel", "tunnel"]],
      "paint": {
        "line-color": "#fefcdb",
        "line-width": {
          "stops": [[8, 0.5], [12, 2], [16, 8], [18, 14]]
        }
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "primary"], ["!=", "brunnel", "tunnel"]],
      "paint": {
        "line-color": "#fce8a8",
        "line-width": {
          "stops": [[7, 0.5], [10, 2], [14, 6], [18, 16]]
        }
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "trunk"], ["!=", "brunnel", "tunnel"]],
      "paint": {
        "line-color": "#fcd6a4",
        "line-width": {
          "stops": [[5, 0.5], [8, 2], [12, 5], [16, 10], [18, 18]]
        }
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "motorway"], ["!=", "brunnel", "tunnel"]],
      "paint": {
        "line-color": "#f0c078",
        "line-width": {
          "stops": [[5, 1], [8, 2], [12, 6], [16, 12], [18, 20]]
        }
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": {
        "line-color": "#bfbfbf",
        "line-width": 1.5,
        "line-dasharray": [4, 4]
      }
    },
    {
      "id": "bridge",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "brunnel", "bridge"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [[10, 1], [14, 4], [18, 14]]
        }
      }
    },
    {
      "id": "admin-boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": {
        "line-color": "#9e9cab",
        "line-width": 2,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "admin-boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#b8b5c4",
        "line-width": 1,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[13, 10], [16, 13]]
        },
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "suburb"],
      "minzoom": 12,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#888888",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "village"],
      "minzoom": 10,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "town"],
      "minzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[8, 11], [12, 14]]
        }
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "minzoom": 5,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [[5, 12], [10, 18]]
        }
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 15,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-offset": [0, 0.8],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#777777",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "housenumber",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "housenumber",
      "minzoom": 17,
      "layout": {
        "text-field": "{housenumber}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 9
      },
      "paint": {
        "text-color": "#999999",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
