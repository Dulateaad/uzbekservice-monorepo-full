{
  "name": "peoplehub",
  "version": "1.0.0",
  "private": true,
  "description": "PeopleHub — платформа взаимного уважения для заказа такси (Telegram Mini App)",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "deploy": "npm run build:client && firebase deploy",
    "deploy:hosting": "npm run build:client && firebase deploy --only hosting",
    "deploy:firestore": "firebase deploy --only firestore",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && npx prisma db seed",
    "db:studio": "cd server && npx prisma studio",
    "emulators": "firebase emulators:start",
    "emulators:firestore": "firebase emulators:start --only firestore",
    "test:emulator": "npm run test:firestore-rules",
    "test:firestore-rules": "node scripts/run-firestore-rules-tests.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "firebase-tools": "^14.27.0"
  }
}
