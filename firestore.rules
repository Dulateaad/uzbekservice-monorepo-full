rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ========== ПОЛЬЗОВАТЕЛИ (users) ==========
    
    match /users/{userId} {
      allow read, list: if isAuthenticated();
      
      allow create: if isAuthenticated() &&
                     request.resource.data.phoneNumber is string &&
                     request.resource.data.name is string &&
                     request.resource.data.userType in ['client', 'specialist', 'company'];
      
      allow update: if isAuthenticated();
      
      allow delete: if isAuthenticated();
      
      match /services/{serviceId} {
        allow read, list: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }
      
      match /saved_cards/{cardId} {
        allow read, list: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }
    }
    
    // ========== СПЕЦИАЛИСТЫ / КЛИЕНТЫ (зеркальные документы профиля) ==========
    match /specialists/{specialistId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /clients/{clientId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    
    // ========== ИНСТРУМЕНТЫ (каталог Firestore) ==========
    match /tools/{toolId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    
    // ========== ПЛАТЕЖИ CLICK (клиент + Functions) ==========
    match /payments/{paymentId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update: if request.auth != null || request.auth == null;
      allow delete: if false;
    }
    
    match /refund_requests/{requestId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    // ========== УВЕДОМЛЕНИЯ ==========
    match /notifications/{notificationId} {
      allow read, list: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // ========== ANAMA PILOT ==========
    match /anama_pilot_sessions/{sessionId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /anama_pilot_daily/{dayKey} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    
    // ========== ЗАКАЗЫ (orders) ==========
    // Требуется Firebase Auth (в т.ч. Anonymous) — включите в Console: Authentication > Sign-in method > Anonymous
    match /orders/{orderId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null &&
                     request.resource.data.clientId is string &&
                     request.resource.data.specialistId is string &&
                     request.resource.data.status is string;
      allow update: if request.auth != null;
      allow delete: if false;
    }
    
    // ========== ОТЗЫВЫ (reviews) ==========
    
    match /reviews/{reviewId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // ========== ЧАТЫ (chats) ==========
    
    match /chats/{chatId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
      
      // Подколлекция сообщений
      match /messages/{messageId} {
        allow read, list: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if false;
        allow delete: if false;
      }
    }
    
    // ========== СООБЩЕНИЯ (messages) — top-level коллекция ==========
    
    match /messages/{messageId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }
    
    // ========== ОБЪЯВЛЕНИЯ (service_ads) ==========
    // Специалисты создают объявления
    match /service_ads/{adId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create: if request.auth != null || request.auth == null;
      allow update: if request.auth != null || request.auth == null;
      allow delete: if request.auth != null || request.auth == null;
    }
    
    // ========== ВАКАНСИИ (vacancies) ==========
    // Доступ: компании и специалисты (создание), все авторизованные (чтение, отклики)
    match /vacancies/{vacancyId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create: if request.auth != null || request.auth == null;
      allow update: if request.auth != null || request.auth == null;
      allow delete: if request.auth != null || request.auth == null;
    }
    
    // ========== SMS КОДЫ (sms_codes) ==========
    
    match /sms_codes/{phoneNumber} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== ОТКЛИКИ НА ВАКАНСИИ ==========
    // Специалисты и клиенты могут откликаться
    match /vacancy_applications/{applicationId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create: if request.auth != null || request.auth == null;
      allow update: if request.auth != null || request.auth == null;
      allow delete: if request.auth != null || request.auth == null;
    }
    
    // ========== BUSINESS HUB: ОРГАНИЗАЦИИ ==========
    // Временно: доступ при auth ИЛИ для анонимных (для тестирования)
    match /bh_organizations/{orgId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create: if request.auth != null || request.auth == null;
      allow update: if request.auth != null || request.auth == null;
      allow delete: if request.auth != null || request.auth == null;
    }
    
    // ========== BUSINESS HUB: ОПЕРАЦИИ ==========
    match /bh_operations/{opId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create: if request.auth != null || request.auth == null;
      allow update: if request.auth != null || request.auth == null;
      allow delete: if request.auth != null || request.auth == null;
    }
    
    // ========== BUSINESS HUB: КОНТРАГЕНТЫ ==========
    match /bh_counterparties/{cpId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create: if request.auth != null || request.auth == null;
      allow update: if request.auth != null || request.auth == null;
      allow delete: if request.auth != null || request.auth == null;
    }
    
    // ========== BUSINESS HUB: HEALTH SCORE ==========
    match /bh_health_scores/{orgId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update: if request.auth != null || request.auth == null;
      allow delete: if false;
    }
    
    // ========== BUSINESS HUB: СОТРУДНИКИ (HR) ==========
    match /bh_employees/{empId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    
    // ========== BUSINESS HUB: УЧАСТНИКИ (RBAC) ==========
    match /bh_organization_members/{memberId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    
    // ========== BUSINESS HUB: ЗАДАЧИ (Workflow) ==========
    match /bh_tasks/{taskId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create: if request.auth != null || request.auth == null;
      allow update: if request.auth != null || request.auth == null;
      allow delete: if request.auth != null || request.auth == null;
    }
    
    // ========== BUSINESS HUB: CRM (Leads, Deals, Activities) ==========
    match /bh_leads/{leadId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_deals/{dealId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_activities/{activityId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    
    // ========== BUSINESS HUB: CRM расширения (справочники, позиции, подписки) ==========
    match /bh_companies/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_contacts/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_products/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_deal_items/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_pipelines/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_crm_tasks/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_subscriptions/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_deal_documents/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    match /bh_crm_notifications/{docId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }
    
    // ========== UNIVERSAL WORK (ODO Core) ==========
    match /works/{workId} {
      allow read, list: if request.auth != null || request.auth == null;
      allow create: if request.auth != null || request.auth == null;
      allow update: if request.auth != null || request.auth == null;
      allow delete: if request.auth != null || request.auth == null;
    }
  }
}
