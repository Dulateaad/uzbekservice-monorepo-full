rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== ПОЛЬЗОВАТЕЛИ (users) ==========
    
    match /users/{userId} {
      allow read, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
      
      match /services/{serviceId} {
        allow read, list: if true;
        allow create, update: if true;
        allow delete: if false;
      }
      
      match /saved_cards/{cardId} {
        allow read, list: if true;
        allow create, update: if true;
        allow delete: if true;
      }
    }
    
    // ========== СПЕЦИАЛИСТЫ / КЛИЕНТЫ (публичные профили) ==========
    match /specialists/{specialistId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /clients/{clientId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== ИНСТРУМЕНТЫ (публичный каталог) ==========
    match /tools/{toolId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    
    // ========== ПЛАТЕЖИ CLICK ==========
    match /payments/{paymentId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    match /refund_requests/{requestId} {
      allow read, list: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    
    // ========== УВЕДОМЛЕНИЯ ==========
    match /notifications/{notificationId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    
    // ========== ANAMA PILOT ==========
    match /anama_pilot_sessions/{sessionId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /anama_pilot_daily/{dayKey} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== ЗАКАЗЫ (orders) ==========
    match /orders/{orderId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== ОТЗЫВЫ (reviews) ==========
    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== ЧАТЫ (chats) ==========
    match /chats/{chatId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
      
      match /messages/{messageId} {
        allow read, list: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }
    
    // ========== СООБЩЕНИЯ (messages) — top-level ==========
    match /messages/{messageId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== ОБЪЯВЛЕНИЯ (публичный просмотр) ==========
    match /service_ads/{adId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    
    // ========== ВАКАНСИИ (публичный просмотр) ==========
    match /vacancies/{vacancyId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== SMS КОДЫ (до авторизации) ==========
    match /sms_codes/{phoneNumber} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== ОТКЛИКИ НА ВАКАНСИИ ==========
    match /vacancy_applications/{applicationId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ========== CPA / APP SETTINGS ==========
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    // ========== BUSINESS HUB: ОРГАНИЗАЦИИ ==========
    match /bh_organizations/{orgId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== BUSINESS HUB: ОПЕРАЦИИ ==========
    match /bh_operations/{opId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    
    // ========== BUSINESS HUB: КОНТРАГЕНТЫ ==========
    match /bh_counterparties/{cpId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    
    // ========== BUSINESS HUB: HEALTH SCORE ==========
    match /bh_health_scores/{orgId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // ========== BUSINESS HUB: СОТРУДНИКИ (HR) ==========
    match /bh_employees/{empId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    
    // ========== BUSINESS HUB: УЧАСТНИКИ (RBAC) ==========
    match /bh_organization_members/{memberId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    
    // ========== BUSINESS HUB: ЗАДАЧИ (Workflow) ==========
    match /bh_tasks/{taskId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    
    // ========== BUSINESS HUB: CRM ==========
    match /bh_leads/{leadId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_deals/{dealId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_activities/{activityId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    
    // ========== BUSINESS HUB: CRM расширения ==========
    match /bh_companies/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_contacts/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_products/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_deal_items/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_pipelines/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_crm_tasks/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_subscriptions/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_deal_documents/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_crm_notifications/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    
    // ========== BUSINESS HUB: бухучёт (Accounting Mode) ==========
    match /bh_chart_accounts/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_journal_entries/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // ========== BUSINESS HUB: график оплат и фин. движения (ядро ТЗ) ==========
    match /bh_installments/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /bh_finance_transactions/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // ========== UNIVERSAL WORK (ODO Core) ==========
    match /works/{workId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ========== ERP (Firestore ERP layer, callable + triggers) ==========
    match /erp_companies/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_contacts/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_products/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_orders/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_order_items/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_payments/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_cash_movements/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_pl_entries/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_stock/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_stock_moves/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_boms/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_bom_items/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_deliveries/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_pos_shifts/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_analytics_daily/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
    match /erp_production_runs/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // ========== PLATFORM (шина событий, аудит, outbox уведомлений) ==========
    match /platform_audit_logs/{docId} {
      allow read, list: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /platform_business_events/{docId} {
      allow read, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
    match /platform_notification_outbox/{docId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
